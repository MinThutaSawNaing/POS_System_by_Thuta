# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
# SECRET_KEY is also used to encrypt credentials stored in the database (such as
# the AI API key entered in Settings). Keep it secret and stable across restarts;
# changing it makes stored secrets undecryptable until they are re-entered.

# Vendor-only master credential that unlocks the ability to create user accounts.
# The password is stored in the database only as a salted hash; the plaintext is
# read from here at startup and never committed. Leave blank to keep the barrier
# unconfigured (user creation stays locked). Rotate by changing the value here
# and restarting.
POS_ACCOUNT_BARRIER_USERNAME=
POS_ACCOUNT_BARRIER_PASSWORD=

# Bind to 127.0.0.1 when a reverse proxy runs on the same VPS. Change to 0.0.0.0
# only when port 8888 must be reachable directly and your firewall permits it.
POS_BIND_ADDRESS=127.0.0.1
POS_PORT=8888

# Optional email two-step login. Configure these here OR in Settings -> Email.
# Settings take precedence; the SMTP password is encrypted with SECRET_KEY.
# Resend SMTP: username resend; use a sending-only API key as the password.
# 465/2465 use SSL/TLS; 25/587/2587 require STARTTLS (never plaintext).
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USERNAME=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Enable for an HTTPS production deployment; leave false for local HTTP only.
SESSION_COOKIE_SECURE=false

# MyanMyanPay: disabled until merchant onboarding + sandbox acceptance.
# Keys stay on the server, never in Settings/browser/localStorage.
# These values are only the bootstrap/fallback. A manager can also save the same
# configuration in Settings -> Payments, where the keys are stored encrypted and
# apply to every branch immediately (Settings overrides these values).
MMPAY_ENABLED=false
MMPAY_APP_ID=
MMPAY_PUBLISHABLE_KEY=
MMPAY_SECRET_KEY=
# Confirm the API base URL in your developer console; do not use the console URL.
MMPAY_API_BASE_URL=
# Public HTTPS URL routed directly to this app (not a login page).
MMPAY_CALLBACK_URL=

# Optional AI in-memory limits. Lower values save memory but retain less context.
AI_MAX_ACTIVE_SESSIONS=16
AI_MAX_HISTORY_MESSAGES=30

# Optional AI model override (APIFree.ai model id, 'vendor/model' format).
# Default: deepseek-ai/deepseek-v4-pro-stable
# Cheaper alternative: deepseek-ai/deepseek-v3.2
# AI_MODEL=deepseek-ai/deepseek-v3.2

# Hours before an unexecuted Loli approval proposal expires (default 24).
# Set to 0 to disable expiry.
# AI_APPROVAL_TTL_HOURS=24

# Optional Loli long-term memory. It remains disabled unless explicitly enabled.
# The embedded setup uses Chroma persisted in /app/instance/loli_memory and a
# local Ollama endpoint for extraction and embeddings. Do not use hosted model
# or vector services for POS memories.
AI_MEMORY_ENABLED=false
AI_MEMORY_MAX_RESULTS=5
AI_MEMORY_MAX_CONTEXT_CHARS=1500
# Docker Desktop: start Ollama locally, pull the listed models, then uncomment.
# AI_MEMORY_MEM0_CONFIG={"vector_store":{"provider":"chroma","config":{"collection_name":"loli_memory","path":"/app/instance/loli_memory"}},"llm":{"provider":"ollama","config":{"model":"llama3.2","ollama_base_url":"http://host.docker.internal:11434"}},"embedder":{"provider":"ollama","config":{"model":"nomic-embed-text","ollama_base_url":"http://host.docker.internal:11434"}}}